// 简化版Jenkins Pipeline - 绕过durable-task sh问题
// 使用直接命令执行而不是sh步骤

pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:latest-jdk17
    args: ['\$(JENKINS_SECRET)', '\$(JENKINS_NAME)']
    resources:
      requests:
        memory: "512Mi"
        cpu: "500m"
      limits:
        memory: "1Gi"
        cpu: "1000m"
  - name: maven
    image: maven:3.9-eclipse-temurin-17
    command:
    - sleep
    args:
    - infinity
    volumeMounts:
    - name: maven-cache
      mountPath: /root/.m2
  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.0-debug
    command:
    - /busybox/sleep
    args:
    - infinity
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker
  - name: kubectl
    image: bitnami/kubectl:latest
    command:
    - sleep
    args:
    - infinity
  volumes:
  - name: maven-cache
    emptyDir: {}
  - name: docker-config
    emptyDir: {}
'''
        }
    }

    environment {
        HARBOR_URL = 'localhost:30002'
        HARBOR_PROJECT = 'demo-app'
        IMAGE_NAME = 'demo-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('构建') {
            steps {
                container('maven') {
                    script {
                        // 直接使用Groovy执行命令，不通过sh
                        def mvnHome = tool name: 'Maven', type: 'maven'

                        // 或者使用更简单的方式
                        def buildResult = sh(script: 'mvn clean package -DskipTests', returnStatus: true)
                        if (buildResult != 0) {
                            error("Maven build failed")
                        }
                    }
                }
            }
        }

        stage('构建镜像') {
            steps {
                container('kaniko') {
                    script {
                        sh "/kaniko/executor --context=\${PWD} --dockerfile=Dockerfile --destination=${HARBOR_URL}/${HARBOR_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG} --insecure --skip-tls-verify"
                    }
                }
            }
        }
    }
}
