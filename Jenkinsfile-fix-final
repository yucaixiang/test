// 最终修复版Jenkins Pipeline
// 关键: 添加jnlp容器并设置正确的remoting通信

pipeline {
    agent {
        kubernetes {
            // 关键配置: 指定默认容器和yaml
            defaultContainer 'maven'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  # JNLP容器 - Jenkins Agent通信必需
  - name: jnlp
    image: jenkins/inbound-agent:latest
    args: ['\$(JENKINS_SECRET)', '\$(JENKINS_NAME)']
    resources:
      requests:
        memory: "256Mi"
        cpu: "100m"
      limits:
        memory: "512Mi"
        cpu: "500m"

  # Maven容器
  - name: maven
    image: maven:3.9-eclipse-temurin-17
    command:
    - cat
    tty: true
    volumeMounts:
    - name: maven-cache
      mountPath: /root/.m2
    resources:
      requests:
        memory: "1Gi"
        cpu: "500m"
      limits:
        memory: "2Gi"
        cpu: "1000m"

  # Kaniko容器
  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.0-debug
    command:
    - /busybox/cat
    tty: true
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker

  # Kubectl容器
  - name: kubectl
    image: bitnami/kubectl:latest
    command:
    - cat
    tty: true

  # Helm容器
  - name: helm
    image: alpine/helm:3.13.0
    command:
    - cat
    tty: true

  volumes:
  - name: maven-cache
    emptyDir: {}
  - name: docker-config
    emptyDir: {}
'''
        }
    }

    environment {
        HARBOR_URL = 'localhost:30002'
        HARBOR_PROJECT = 'demo-app'
        HARBOR_CREDENTIAL = credentials('harbor-admin')
        IMAGE_NAME = 'demo-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE_NAME = "${HARBOR_URL}/${HARBOR_PROJECT}/${IMAGE_NAME}"
        K8S_NAMESPACE = 'default'
        HELM_RELEASE_NAME = 'demo-app'
        HELM_CHART_PATH = 'demo-app-chart'
        MAVEN_OPTS = '-Dmaven.repo.local=.m2/repository'
    }

    stages {
        stage('代码检出') {
            steps {
                echo '===== 开始检出代码 ====='
                checkout scm
                echo '代码检出完成'
            }
        }

        stage('Maven构建') {
            steps {
                container('maven') {
                    echo '===== 开始Maven构建 ====='
                    sh 'mvn --version'
                    sh 'mvn clean package -DskipTests'
                    sh 'ls -lh target/*.jar'
                }
            }
        }

        stage('单元测试') {
            steps {
                container('maven') {
                    echo '===== 开始执行单元测试 ====='
                    sh 'mvn test'
                }
            }
        }

        stage('构建Docker镜像') {
            steps {
                container('kaniko') {
                    echo '===== 开始构建Docker镜像 ====='
                    sh """
                        mkdir -p /kaniko/.docker
                        echo '{"auths":{"${HARBOR_URL}":{"auth":"'"\$(echo -n '${HARBOR_CREDENTIAL_USR}:${HARBOR_CREDENTIAL_PSW}' | base64)"'"}}}' > /kaniko/.docker/config.json
                        /kaniko/executor \\
                          --context=\${PWD} \\
                          --dockerfile=Dockerfile \\
                          --destination=${FULL_IMAGE_NAME}:${IMAGE_TAG} \\
                          --destination=${FULL_IMAGE_NAME}:latest \\
                          --insecure \\
                          --skip-tls-verify
                    """
                }
            }
        }

        stage('Helm部署') {
            steps {
                container('helm') {
                    echo '===== 开始Helm部署 ====='
                    sh """
                        helm upgrade --install ${HELM_RELEASE_NAME} ${HELM_CHART_PATH} \\
                          --namespace ${K8S_NAMESPACE} \\
                          --create-namespace \\
                          --set image.tag=${IMAGE_TAG} \\
                          --set image.repository=${FULL_IMAGE_NAME} \\
                          --wait \\
                          --timeout 5m
                    """
                }
            }
        }

        stage('部署验证') {
            steps {
                container('kubectl') {
                    echo '===== 开始验证部署 ====='
                    sh "kubectl wait --for=condition=ready pod -l app=${IMAGE_NAME} -n ${K8S_NAMESPACE} --timeout=300s"
                    sh "kubectl get pods -n ${K8S_NAMESPACE} -l app=${IMAGE_NAME}"
                }
            }
        }
    }

    post {
        success {
            echo '''
            ✅ Pipeline执行成功！
            访问地址: http://localhost:30088/api/hello
            '''
        }
        failure {
            echo '❌ Pipeline执行失败'
        }
    }
}
